{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blinc-site",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "blinc.rs", "custom_domain": true }],
  "assets": {
    "directory": "./target/site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
