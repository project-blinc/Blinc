// Form-ish widgets: the button variant/size matrix and labels.
//
// One module per widget group so the playground stays small as new
// widgets land -- add a module, add one import line, add one call.

// Two-way text binding: the field writes this signal on every edit,
// and the chip / label / alert read it. The `= "…"` seeds it, so the
// field opens showing that text.
signal form_name: string = "Change this value"
// The textarea binds the same way: no `key` needed, because the signal
// IS the field's identity, and its contents survive a rebuild.
signal form_bio: string

// Toolbar toggles: buttons that stay down, bound like a switch.
signal fmt_bold: bool = false
signal fmt_italic: bool = false

// One of a set. The buttons below write the same signal the dials do.
signal plan: string = "free"
// Shared by both toggle bars, so picking in one moves the other.
signal text_align: string = "left"

// The code fills one character per slot; the chip below reads it.
signal otp_code: string = ""

// A number picked by dragging; the progress bar reads the same signal.
signal volume: f64 = 40.0
signal quantity: f64 = 3.0

// A handle onto the field below. Unlike a signal, which carries the
// value, a ref carries the element: it focuses, selects and clears
// without anything having to re-render.
ref search: Input

// The same handle shape for the multi-line field below.
ref bio: Textarea

component FormWidgets {
    style {
        .group { width: 100%; padding: 24px; gap: 16px; flex-direction: column }
        .row { gap: 10px; flex-direction: row; align-items: center; flex_wrap: wrap }
        // Stacking inside a section.
        .col { gap: 8px; flex-direction: column; align-items: flex-start }
    }

    view {
        Div(class = "group") {
            cn.Label("button variants")
            Div(class = "row") {
                cn.Button("primary")
                cn.Button("secondary", variant = "secondary")
                cn.Button("destructive", variant = "destructive")
                cn.Button("outline", variant = "outline")
                cn.Button("ghost", variant = "ghost")
                cn.Button("link", variant = "link")
            }

            cn.Label("button sizes + disabled")
            Div(class = "row") {
                cn.Button("small", size = "small")
                cn.Button("medium", size = "medium")
                cn.Button("large", size = "large")
                cn.Button("disabled", disabled = true)
            }

            cn.Label("text fields: `key` is what persists your typing")
            Div(class = "row") {
                cn.Input(key = "pg_user", label = "User", placeholder = "username")
                cn.Input(
                    key = "pg_pw",
                    label = "Password",
                    placeholder = "secret",
                    kind = "password"
                )
            }
            
            cn.Textarea(ref = bio, value = form_bio, label = "Bio",
                        placeholder = "a few words", rows = 3)
            Div(class = "row") {
                cn.Button("Focus bio", size = "small", on_click = || bio.focus())
                cn.Button("Clear bio", variant = "destructive", size = "small",
                          on_click = || bio.clear())
            }

            // `ref` drives the field directly: no signal in the middle,
            // and nothing re-renders to make it happen.
            cn.Label("slider: drag writes the signal, a write moves the thumb")
            Div(class = "col") {
                cn.Slider(value = volume, min = 0.0, max = 100.0, step = 5.0,
                          w = 320.0, label = "Volume", show_value = true)
                cn.Progress(value = volume, size = "small")
            }

            cn.Label("number input: typed or stepped")
            Div(class = "row") {
                cn.NumberInput(value = quantity, min = 1.0, max = 99.0, step = 1.0,
                               w = 140.0)
                cn.Label("type here, the slider follows")
                cn.Slider(value = quantity, min = 1.0, max = 99.0, w = 200.0)
            }

            // Each option names itself, so its value and its label are
            // declared together.
            cn.Label("radio: pick one of a set")
            cn.RadioGroup(value = plan, label = "Plan") {
                cn.Radio(value = "free", label = "Free")
                cn.Radio(value = "pro", label = "Pro")
                cn.Radio(value = "team", label = "Team", disabled = true)
            }
            Div(class = "row") {
                cn.Label("horizontal, and driven from outside")
                cn.Button("Pick Pro", size = "small", variant = "outline",
                          on_click = || plan.set("pro"))
            }
            cn.RadioGroup(value = plan, layout = "horizontal", size = "small") {
                cn.Radio(value = "free", label = "Free")
                cn.Radio(value = "pro", label = "Pro")
            }

            // Same choice as the radios above, on the same signal, but
            // folded away until asked for. Picking in either moves both.
            cn.Label("select: pick one from a list that drops down")
            Div(class = "row") {
                cn.Select(value = plan, label = "Plan", placeholder = "Pick one", w = 180.0) {
                    cn.Option(value = "free", label = "Free")
                    cn.Option(value = "pro", label = "Pro")
                    cn.Option(value = "team", label = "Team", disabled = true)
                }
            }

            cn.Label("otp: one slot per character, focus walks itself")
            cn.InputOTP(value = otp_code, length = 6.0, numeric_only = true)
            Div(class = "row") {
                cn.Label("typed so far:")
                cn.Badge(otp_code, variant = "secondary")
                cn.Button("Prefill", size = "small", variant = "outline",
                          on_click = || otp_code.set("1234"))
                cn.Button("Clear", size = "small", variant = "outline",
                          on_click = || otp_code.set(""))
            }

            cn.Label("toggle: a button that stays down")
            Div(class = "row") {
                cn.Toggle(pressed = fmt_bold, icon = "bold", aria_label = "bold")
                cn.Toggle(pressed = fmt_italic, icon = "italic", aria_label = "italic")
                cn.Toggle(pressed = fmt_bold, label = "Bold", variant = "outline")
                cn.Switch(checked = fmt_bold, label = "same signal")
            }

            // One picked at a time, as chips rather than dials. The
            // children are ordinary cn.Toggles: inside a group they take
            // a `value` and give up their own `pressed`. Clicking the
            // selected one is a no-op; a standalone toggle can turn
            // itself off.
            //
            // Icon-only, so each carries an aria_label: there is no text
            // for a screen reader to fall back on.
            cn.Label("toggle group: one of a set, as a bar")
            Div(class = "row") {
                cn.ToggleGroup(value = text_align, variant = "outline") {
                    cn.Toggle(value = "left", icon = "text-align-start", aria_label = "Align left")
                    cn.Toggle(value = "center", icon = "text-align-center", aria_label = "Align centre")
                    cn.Toggle(value = "right", icon = "text-align-end", aria_label = "Align right")
                    cn.Toggle(value = "justify", icon = "text-align-justify", aria_label = "Justify")
                }
            }
            // Same signal, so the two bars move together. Different size,
            // which is also what keeps their per-chip state apart.
            Div(class = "row") {
                cn.ToggleGroup(value = text_align, size = "small") {
                    cn.Toggle(value = "left", icon = "text-align-start", aria_label = "Align left")
                    cn.Toggle(value = "center", icon = "text-align-center", aria_label = "Align centre")
                    cn.Toggle(value = "right", icon = "text-align-end", aria_label = "Align right")
                    cn.Toggle(value = "justify", icon = "text-align-justify", aria_label = "Justify")
                }
                cn.Button("Centre it", size = "small",
                          on_click = || text_align.set("center"))
                cn.Badge(text_align, variant = "secondary")
            }

            cn.Label("ref: drive a field without a signal")
            Div(class = "row") {
                cn.Input(ref = search, key = "pg_search", placeholder = "search")
                cn.Button("Focus", size = "small", on_click = || search.focus())
                cn.Button("Select", variant = "secondary", size = "small",
                          on_click = || search.select_all())
                cn.Button("Clear", variant = "destructive", size = "small",
                          on_click = || search.clear())
            }

            // Every text prop below takes the same signal: text content
            // has no property writer, so each rebuilds through deps()
            // and carries its own colour rather than inheriting one.
            cn.Label("input: `value` is two-way; chip, label and alert all follow it")
            Div(class = "row") {
                cn.Input(value = form_name, placeholder = "type a name")
                cn.Badge(label = form_name, variant = "secondary")
                cn.Label(form_name)
            }
            cn.Alert(form_name)

            cn.Label("kbd")
            Div(class = "row") {
                cn.Kbd("Ctrl", size = "small")
                cn.Kbd("K", size = "small")
            }

            cn.Label("label: size, required, disabled")
            Div(class = "row") {
                cn.Label("small", size = "small")
                cn.Label("required", required = true)
                cn.Label("disabled", disabled = true)
            }
        }
    }
}
