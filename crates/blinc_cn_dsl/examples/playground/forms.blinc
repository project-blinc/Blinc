// Form-ish widgets: the button variant/size matrix and labels.
//
// One module per widget group so the playground stays small as new
// widgets land -- add a module, add one import line, add one call.

// Two-way text binding: the field writes this signal on every edit,
// and the chip / label / alert read it. The `= "…"` seeds it, so the
// field opens showing that text.
signal form_name: string = "Change this value"
// The textarea binds the same way: no `key` needed, because the signal
// IS the field's identity, and its contents survive a rebuild.
signal form_bio: string

component FormWidgets {
    style {
        .group { width: 100%; padding: 24px; gap: 16px; flex-direction: column }
        .row { gap: 10px; flex-direction: row; align-items: center; flex_wrap: wrap }
    }

    view {
        Div(class = "group") {
            cn.Label("button variants")
            Div(class = "row") {
                cn.Button("primary")
                cn.Button("secondary", variant = "secondary")
                cn.Button("destructive", variant = "destructive")
                cn.Button("outline", variant = "outline")
                cn.Button("ghost", variant = "ghost")
                cn.Button("link", variant = "link")
            }

            cn.Label("button sizes + disabled")
            Div(class = "row") {
                cn.Button("small", size = "small")
                cn.Button("medium", size = "medium")
                cn.Button("large", size = "large")
                cn.Button("disabled", disabled = true)
            }

            cn.Label("text fields: `key` is what persists your typing")
            Div(class = "row") {
                cn.Input(key = "pg_user", label = "User", placeholder = "username")
                cn.Input(
                    key = "pg_pw",
                    label = "Password",
                    placeholder = "secret",
                    kind = "password"
                )
            }
            
            cn.Textarea(value = form_bio, label = "Bio", placeholder = "a few words", rows = 3)

            // Every text prop below takes the same signal: text content
            // has no property writer, so each rebuilds through deps()
            // and carries its own colour rather than inheriting one.
            cn.Label("input: `value` is two-way; chip, label and alert all follow it")
            Div(class = "row") {
                cn.Input(value = form_name, placeholder = "type a name")
                cn.Badge(label = form_name, variant = "secondary")
                cn.Label(form_name)
            }
            cn.Alert(form_name)

            cn.Label("kbd")
            Div(class = "row") {
                cn.Kbd("Ctrl", size = "small")
                cn.Kbd("K", size = "small")
            }

            cn.Label("label: size, required, disabled")
            Div(class = "row") {
                cn.Label("small", size = "small")
                cn.Label("required", required = true)
                cn.Label("disabled", disabled = true)
            }
        }
    }
}
