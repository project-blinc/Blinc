// Kitchen sink for the DSL widget surface: a navigation rail down the
// left, one page at a time on the right.
//
// Each page is a component in its own module, imported below. Adding one
// is three lines: an import, a `cn.SidebarItem`, and a `match` arm.
//
// Local CSS is layout only -- widgets take their appearance from
// CN_STYLES and the theme, so a regression in either shows up here
// rather than being masked by per-example overrides.
//
// Compile with `compile_project(main.blinc, playground/)`: imports are
// resolved by walking the module graph from the entry, which
// `compile_source` / `compile_file` alone do not do.

import { FormWidgets } from "./forms"
import { FeedbackWidgets } from "./feedback"
import { MediaWidgets } from "./media"
import { ReactivePage } from "./reactive"

// Which page the rail is showing. A string rather than an index so the
// match arms name what they render.
signal page: string = "forms"

// The rail's own state. Bound rather than left to the widget so anything
// else could collapse it too, and so this file can read it.
signal nav_shut: bool = false

// A handle onto the content area's scroller. The area outlives a page
// swap, so without sending it back to the top a short page inherits a
// tall one's offset and opens scrolled past its own content.
ref pages: Scroll

// The arms of the `match` are the pages; the `with` around it scopes a
// swap to the content area.
component KitchenSink {
    style {
        // 100% size of the host viewport
        .shell { width: 100%; height: 100%; flex-direction: row }
    }

    view {
        Div(class = "shell") {
            cn.Sidebar(collapsed = nav_shut, expanded_w = 200.0) {
                cn.SidebarSection(title = "Widgets") {
                    cn.SidebarItem(label = "Forms", icon = "square-pen", active = true,
                                   on_click = || { page.set("forms") pages.scroll_to_top() })
                    cn.SidebarItem(label = "Feedback", icon = "bell",
                                   on_click = || { page.set("feedback") pages.scroll_to_top() })
                    cn.SidebarItem(label = "Media", icon = "image",
                                   on_click = || { page.set("media") pages.scroll_to_top() })
                }
                cn.SidebarSection(title = "Reactivity") {
                    cn.SidebarItem(label = "Bindings", icon = "zap",
                                   on_click = || { page.set("reactive") pages.scroll_to_top() })
                }
                cn.SidebarContent(ref = pages) {
                    Div {
                        with {
                            match page.get() {
                                "forms" -> FormWidgets(),
                                "feedback" -> FeedbackWidgets(),
                                "media" -> MediaWidgets(),
                                _ -> ReactivePage(),
                            }
                        }
                    }
                }
            }
        }
    }
}

view { KitchenSink() }
