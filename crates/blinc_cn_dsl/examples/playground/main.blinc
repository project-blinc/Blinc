// Playground entry point for the DSL widget surface.
//
// The static widget gallery lives in one module per group, imported
// below, so this file stays small as widgets land: add a module, add an
// import, add one call.
//
// State lives in the FSM's `context` block, co-located with the actions
// that mutate it and the view that reads it.
//
// Reactive mechanisms, side by side so a regression in one shows up
// against the others:
//
//   in-place property write  cn.Skeleton(w/h/rounded),
//     cn.Separator(opacity), cn.Progress(value). Bindable properties,
//     so a set patches RenderProps -- no rebuild, no compute_layout.
//
//   deps() subtree rebuild   cn.Button(label/disabled). Text content
//     has no property writer, and `disabled` gates the whole style
//     branch plus the FSM start state.
//
//   derived                  cn.Progress(value = computed { ... }),
//     including one value over two signals. A derived binding fires
//     when either dependency sets.
//
//   scoped re-render         `with Play { ... }`, the alert/spinner
//     block. A branch swap is structural, so it needs a re-render --
//     the region confines that to its own subtree instead of the
//     program, which is what `@stateful` on a view would cost.
//
// The f64 props also cover the numeric-width path: the DSL types every
// number as f64 while layout stores f32, and the narrowing happens
// inside the binding layer, not at the call site.
//
// Local CSS is layout only -- widgets take their appearance from
// CN_STYLES and the theme, so a regression in either shows here rather
// than being masked by per-example overrides.
//
// Compile with `compile_project(main.blinc, playground/)`: imports are
// resolved by walking the module graph from the entry, which
// `compile_source` / `compile_file` alone do not do.

import { FormWidgets } from "./forms"
import { FeedbackWidgets } from "./feedback"
import { MediaWidgets } from "./media"


fsm Play {
    context {
        pct: f64 = 0.0
        bar_w: f64 = 90.0
        bar_h: f64 = 90.0
        radius: f64 = 4.0
        fade: f64 = 1.0
        busy: bool = false
        caption: string = "Save"
    }
    state Idle
    initial Idle

    on Idle.Grow -> Idle {
        ctx.pct += 10.0          // cn.Progress expects 0..=100
        // Small increments: the skeleton is demonstrating that w / h /
        // rounded patch in place, and large steps turn it into a blob
        // within a few clicks rather than showing the binding.
        ctx.bar_w += 12.0
        ctx.bar_h += 2.0
        ctx.radius += 1.0
        ctx.fade -= 0.12         // Div::opacity clamps, so this may undershoot
    }

    // Flips both Button props at once: label and disabled come from
    // different signals, one deps() rebuild covers both.
    on Idle.Busy -> Idle {
        ctx.busy = true
        ctx.caption = "Saving..."
    }

    on Idle.Reset -> Idle {
        ctx.pct = 0.0
        ctx.bar_w = 90.0
        ctx.bar_h = 90.0
        ctx.radius = 4.0
        ctx.fade = 1.0
        ctx.busy = false
        ctx.caption = "Save"
    }
}

// Two ways to read an FSM context field, and they are not
// interchangeable:
//
//   `Play.busy`        the binding handle -- what a prop wants
//                      (`disabled = Play.busy`). The property binding
//                      redraws on set; nothing is rebuilt.
//   `Play.busy.get()`  the value -- what an expression wants, as in
//                      counter_dsl's `f"{CounterFsm.count.get()}"`.
//
// The condition below reads a value, so it takes `.get()`.
//
// Wrapped in a component, matching cn_dsl_demo and reactive_dsl: fsm
// at top level, `component X { style { } view { } }`, then
// `view { X() }`. Root-level `style { }` is supported too -- it is
// extracted by `extract_and_strip_stylesheets` and flushed into the
// context on the first `view_widget()` -- but the component form is
// the convention the other examples follow.
// A view-returning function: one row of the mapped list. Its body is an
// ordinary statement scope, which is what lets `map`'s closure do work
// before naming a widget.
//
// `: View` is optional -- a body ending in a widget call is inferred to
// produce one -- but stating it documents the intent at the call site.
fn Tag(label: string): View {
    cn.Badge(label, variant = "secondary")
}

component Playground {
    style {
        .page {
            padding: 24px;
            gap: 16px;
            flex-direction: column;
            width: 100%;
            height: 100vh;
            overflow: scroll;
        }
        .row { gap: 8px; flex-direction: row; align-items: center; flex-wrap: wrap }
    }

    view {
        let tags = ["alpha", "beta", "gamma"]
        Div(class = "page") {
            FormWidgets()
            FeedbackWidgets()
            MediaWidgets()

            // List rendering: the list binds in the view body, and
            // `map` puts one child per element in the widget body. The
            // row is a `: View` function, so its body is a scope that
            // can hold a binding -- a widget body cannot, being a
            // children list rather than a statement list.
            cn.Label("map: one child per element, via a `: View` fn")
            Div(class = "row") {
                tags.map(|t| Tag(t))
            }

            cn.Label("progress: value = pct (in-place)")
            Div(class = "row") {
                cn.Progress(value = Play.pct, size = "medium")
            }

            cn.Label("skeleton: w / h / rounded all bound (in-place)")
            Div(class = "row") {
                cn.Skeleton(w = Play.bar_w, h = Play.bar_h, rounded = Play.radius)
            }

            cn.Label("separator: opacity bound (clamped by Div::opacity)")
            Div(class = "row") {
                cn.Separator(opacity = Play.fade)
            }

            // Derived values bind to the upstream derived itself, so
            // these track like the signal-bound props above.
            cn.Label("progress: computed { pct / 2 }")
            Div(class = "row") {
                cn.Progress(value = computed { Play.pct / 2.0 } : f64)
            }

            cn.Label("progress: computed over TWO signals")
            Div(class = "row") {
                cn.Progress(value = computed { Play.pct + Play.radius } : f64)
            }

            // Two-way: the toggles read Play.busy AND write it, so
            // clicking either one flips the `with Play` region below
            // and the button under them, exactly as the Busy action
            // does. Both toggles track each other for the same reason
            // -- one signal, two views of it.
            cn.Label("toggles: two-way bound to Play.busy")
            Div(class = "row") {
                cn.Switch(checked = Play.busy, label = "busy")
                cn.Checkbox(checked = Play.busy, label = "busy")
            }

            cn.Label("button: label AND disabled both bound (deps rebuild)")
            Div(class = "row") {
                cn.Button(label = Play.caption, disabled = Play.busy)
            }

            // Content, so it takes the deps() rebuild path -- same as
            // the button label above and for the same reason. Sharing
            // the signal means Busy moves both at once.
            cn.Label("kbd: content bound (deps rebuild)")
            Div(class = "row") {
                cn.Kbd(text = Play.caption)
            }

            // Swapping a branch is structural, which a redraw cannot
            // do, so this slice has to re-render. `with` scopes that to
            // the slice: a transition rebuilds these nodes and nothing
            // else, so the switch's thumb spring and the toggles above
            // keep whatever they had in flight.
            //
            // No dependency named at all. The region's deps are
            // whatever its body READ while rendering -- here just
            // `Play.busy`, via the `.get()` below. Grow writes five
            // other context fields and this region ignores every one of
            // them, because it never read them.
            //
            // Naming them still works: `with Play` classifies the name
            // against the declared signals and FSMs, and
            // `with @fsm([Play])` spells the mechanism out. Both lower
            // identically. They are documentation now rather than the
            // mechanism that finds the dependencies.
            //
            // The decorated-component form (`component X { @stateful
            // @fsm([Play]) view { ... } }`) still works and is the right
            // tool when the state behaviour deserves a name. It sets a
            // global flag, though: every signal write then rebuilds
            // every node in the program, which is what this region
            // avoids. `BusyPanel` used to be exactly that -- a component
            // whose only job was to carry the decoration.
            with {
                Div(class = "row") {
                    if Play.busy.get() {
                        cn.Alert("busy - work in flight", variant = "warning")
                        cn.Spinner(size = "small")
                    } else {
                        cn.Alert("idle - press Busy", variant = "success")
                    }
                }
            }

            Div(class = "row") {
                cn.Button("Grow", on_click = || { Play.trigger("Grow") })
                cn.Button("Busy", variant = "secondary", on_click = || { Play.trigger("Busy") })
                cn.Button("Reset", variant = "destructive", on_click = || { Play.trigger("Reset") })
            }
        }
    }
}

view { Playground() }
