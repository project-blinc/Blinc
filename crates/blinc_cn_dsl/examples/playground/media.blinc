// Avatars, cards, separators, and the static skeleton shape.

signal details: bool = false
signal warranty: bool = false

component MediaWidgets {
    style {
        .group { width: 100%; padding: 24px; gap: 16px; flex-direction: column }
        .row { gap: 10px; flex-direction: row; align-items: center; flex_wrap: wrap }
        .richtext-narrow { width: 280px; align-items: flex-start }
        // Author classes on a cn widget. They ADD to the classes the
        // widget carries itself, so `.cn-badge`'s own pill shape and
        // padding survive and only what is named here changes.
        .tag-wide { width: 120px }
        .tag-square { border-radius: 4px }
        // font-style inherits, so this slants the Text inside it without
        // the Text naming a style of its own.
        .quote { font-style: italic; color: var(--text-secondary) }
    }

    view {
        Div(class = "group") {
            // One constructor per rung, mirroring cn::h1(..) — cn::caption(..).
            cn.H2("Typography")
            cn.P("Six headings, a paragraph, and two quiet variants.")
            cn.H4("h4 introduces a subsection")
            cn.Muted("muted plays support")
            cn.Caption("captions annotate")
            cn.ChainedText {
                cn.Span("Inline runs share a baseline: ")
                cn.B("bold")
                cn.Span(", ")
                cn.InlineCode("code()")
                cn.Span(", and ")
                cn.Small("small print.")
            }

            // Two routes to the same flags. Props suit a one-off; a class
            // suits a rule, and reaches the typography widgets too, which
            // take a class but no style props.
            cn.Label("text styles: as props, and as CSS")
            Div(class = "row") {
                Text("italic", italic = true)
                Text("bold", bold = true)
                Text("struck", strikethrough = true)
                Text("underlined", underline = true)
            }
            Div(class = "quote") {
                Text("inherited italic, from the container's font-style")
            }

            // Core widgets, no cn. prefix — same tier as Div and Text.
            // One node: formatting mid-sentence survives a wrap, which
            // cn.ChainedText (separate elements) cannot manage.
            cn.Label("rich text: inline markup in a single node")
            RichText("Press <b>Enter</b> to accept, <i>Escape</i> to cancel, or read the <a href='https://example.com'>manual</a>.")

            // Narrow on purpose: the paragraph wraps, and the link sits
            // past the first break. Its pointer and its click both follow
            // it there, because both are placed against this width rather
            // than measured as one long line.
            cn.Label("rich text: wrapped, with a link on a later line")
            Div(class = "richtext-narrow") {
                RichText("A paragraph long enough to need several lines in this column, with <b>bold</b> and <i>italic</i> runs that keep their styling across a break, and a <a href='https://example.com'>link near the end</a> that still takes the pointer.")
            }

            // The LINK ITSELF spans lines here, not just the paragraph.
            // It gets one hit rect per line rather than one box across
            // both, so the pointer appears over every part of the link
            // text and nowhere in the gaps beside it. Hover the tail on
            // the second line: that is the half a single rect would miss.
            cn.Label("rich text: a link whose own text wraps")
            Div(class = "richtext-narrow") {
                RichText("See the <a href='https://example.com'>complete reference manual for keyboard shortcuts and editing commands</a> before filing an issue.")
            }

            cn.Label("markdown: a block becomes a column of elements")
            // A real multi-line string: escapes are not interpreted,
            // so a newline is written as a newline.
            Markdown("## Heading

A paragraph with **bold** and `code`.

- first item
- second item")

            // `class` reaches a cn widget the same way it reaches a Div.
            // The first badge is untouched, so the difference is the
            // rule and nothing else.
            cn.Label("class: style a cn widget with your own CSS")
            Div(class = "row") {
                cn.Badge("plain", variant = "secondary")
                cn.Badge("wide", variant = "secondary", class = "tag-wide")
                cn.Badge("squared", variant = "secondary", class = "tag-square")
                cn.Badge("both", variant = "secondary", class = "tag-wide tag-square")
            }

            cn.Label("avatar: size x shape")
            Div(class = "row") {
                cn.Avatar(fallback = "AB", size = "small")
                cn.Avatar(fallback = "CD", size = "medium")
                cn.Avatar(fallback = "EF", size = "large")
                cn.Avatar(fallback = "GH", shape = "square")
            }

            cn.Label("card: container with children")
            cn.Card {
                cn.Label("card content")
                cn.Badge("A nested content", variant = "secondary")
                //cn.Badge("Another nested content with primary badge")
                //cn.Badge("Hot reloading FTW!", variant = "success")
            }

            // The first collection prop: a list literal crosses as one
            // pointer to Zyntax's `List<T>`, and the last entry is the
            // current page.
            cn.Label("breadcrumb: items is a list literal")
            Div(class = "row") {
                cn.Breadcrumb(items = ["Home", "Components", "Breadcrumb"])
            }
            Div(class = "row") {
                cn.Breadcrumb(items = ["Docs", "Guide"], separator = "/")
            }

            // The box holds its ratio regardless of what the content
            // measures — the skeleton inside is deliberately smaller.
            cn.Label("aspect ratio: 16:9 and 1:1 at the same width")
            Div(class = "row") {
                cn.AspectRatio(preset = "widescreen", w = 200.0, bg = "#2A3050", rounded = 6.0) {
                    cn.Label("16:9")
                }
                cn.AspectRatio(preset = "square", w = 120.0, bg = "#2A3050", rounded = 6.0) {
                    cn.Label("1:1")
                }
            }

            cn.Label("scroll area: six rows in a 60px box")
            cn.ScrollArea(direction = "vertical", scrollbar = "hover", h = 60.0, w = 100.0) {
                cn.Label("row one")
                cn.Label("row two")
                cn.Label("row three")
                cn.Label("row four")
                cn.Label("row five")
                cn.Label("row six")
            }

            cn.Label("collapsible: folded by a bound signal")
            cn.Switch(checked = details, label = "details")
            cn.Collapsible(open = details) {
                cn.Label("hidden until the switch is on")
                cn.Label("and folds away when it is off")
            }

            // Each section names itself, so a label and the body under
            // it are declared together and cannot drift apart.
            cn.Label("accordion: one section open at a time")
            cn.Accordion {
                cn.AccordionItem(label = "Shipping", open = true) {
                    Div { Text("Ships in two to three days.") }
                }
                cn.AccordionItem(label = "Returns") {
                    Div { Text("Thirty days, unopened.") }
                }
                cn.AccordionItem(label = "Warranty") {
                    Div { Text("One year against defects.") }
                }
            }

            // `open` binds both ways: the switch folds the section, and
            // clicking the header moves the switch.
            cn.Label("accordion: multi = true, second section bound")
            cn.Switch(checked = warranty, label = "bound section")
            cn.Accordion(multi = true) {
                cn.AccordionItem(label = "Unbound") {
                    Div { Text("opening another leaves this one open") }
                }
                cn.AccordionItem(label = "Bound", open = warranty) {
                    Div { Text("the switch above folds this section") }
                }
            }

            cn.Label("separator + static skeleton")
            cn.Separator()
            cn.Skeleton(w = 140.0, h = 140.0, rounded = 6.0)
        }
    }
}
