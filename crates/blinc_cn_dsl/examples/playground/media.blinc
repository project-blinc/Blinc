// Avatars, cards, separators, and the static skeleton shape.

signal details: bool = false
signal warranty: bool = false

component MediaWidgets {
    style {
        .group { gap: 16px; flex-direction: column }
        .row { gap: 10px; flex-direction: row; align-items: center; flex_wrap: wrap }
    }

    view {
        Div(class = "group") {
            cn.Label("avatar: size x shape")
            Div(class = "row") {
                cn.Avatar(fallback = "AB", size = "small")
                cn.Avatar(fallback = "CD", size = "medium")
                cn.Avatar(fallback = "EF", size = "large")
                cn.Avatar(fallback = "GH", shape = "square")
            }

            cn.Label("card: container with children")
            cn.Card {
                cn.Label("card content")
                cn.Badge("A nested content", variant = "secondary")
                //cn.Badge("Another nested content with primary badge")
                //cn.Badge("Hot reloading FTW!", variant = "success")
            }

            // The first collection prop: a list literal crosses as one
            // pointer to Zyntax's `List<T>`, and the last entry is the
            // current page.
            cn.Label("breadcrumb: items is a list literal")
            Div(class = "row") {
                cn.Breadcrumb(items = ["Home", "Components", "Breadcrumb"])
            }
            Div(class = "row") {
                cn.Breadcrumb(items = ["Docs", "Guide"], separator = "/")
            }

            // The box holds its ratio regardless of what the content
            // measures — the skeleton inside is deliberately smaller.
            cn.Label("aspect ratio: 16:9 and 1:1 at the same width")
            Div(class = "row") {
                cn.AspectRatio(preset = "widescreen", w = 200.0, bg = "#2A3050", rounded = 6.0) {
                    cn.Label("16:9")
                }
                cn.AspectRatio(preset = "square", w = 120.0, bg = "#2A3050", rounded = 6.0) {
                    cn.Label("1:1")
                }
            }

            cn.Label("scroll area: six rows in a 60px box")
            cn.ScrollArea(direction = "vertical", scrollbar = "hover", h = 60.0, w = 100.0) {
                cn.Label("row one")
                cn.Label("row two")
                cn.Label("row three")
                cn.Label("row four")
                cn.Label("row five")
                cn.Label("row six")
            }

            cn.Label("collapsible: folded by a bound signal")
            cn.Switch(checked = details, label = "details")
            cn.Collapsible(open = details) {
                cn.Label("hidden until the switch is on")
                cn.Label("and folds away when it is off")
            }

            // Each section names itself, so a label and the body under
            // it are declared together and cannot drift apart.
            cn.Label("accordion: one section open at a time")
            cn.Accordion {
                cn.AccordionItem(label = "Shipping", open = true) {
                    Div { Text("Ships in two to three days.") }
                }
                cn.AccordionItem(label = "Returns") {
                    Div { Text("Thirty days, unopened.") }
                }
                cn.AccordionItem(label = "Warranty") {
                    Div { Text("One year against defects.") }
                }
            }

            // `open` binds both ways: the switch folds the section, and
            // clicking the header moves the switch.
            cn.Label("accordion: multi = true, second section bound")
            cn.Switch(checked = warranty, label = "bound section")
            cn.Accordion(multi = true) {
                cn.AccordionItem(label = "Unbound") {
                    Div { Text("opening another leaves this one open") }
                }
                cn.AccordionItem(label = "Bound", open = warranty) {
                    Div { Text("the switch above folds this section") }
                }
            }

            cn.Label("separator + static skeleton")
            cn.Separator()
            cn.Skeleton(w = 140.0, h = 140.0, rounded = 6.0)
        }
    }
}
