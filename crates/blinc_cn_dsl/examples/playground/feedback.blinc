// Status / feedback widgets: badges, alerts, spinners.

component FeedbackWidgets {
    style {
        .group { width: 100%; padding: 24px; gap: 16px; flex-direction: column }
        .row { gap: 10px; flex-direction: row; align-items: center; flex_wrap: wrap }
    }

    view {
        Div(class = "group") {
            cn.Label("badge: variant x style")
            Div(class = "row") {
                cn.Badge("default")
                cn.Badge("secondary", variant = "secondary")
                cn.Badge("success", variant = "success")
                cn.Badge("warning", variant = "warning")
                cn.Badge("destructive", variant = "destructive")
                cn.Badge("solid", variant = "success", style = "solid")
            }

            cn.Label("alert variants")
            cn.Alert("default alert")
            cn.Alert("something went wrong", variant = "destructive")
            cn.Alert("saved successfully", variant = "success")
            cn.Alert("check your input", variant = "warning")

            cn.Label("spinner sizes")
            Div(class = "row") {
                cn.Spinner(size = "small")
                cn.Spinner(size = "medium")
                cn.Spinner(size = "large")
            }

            // The body IS the trigger: the tooltip hangs off whatever
            // is inside it.
            cn.Label("tooltip: hover the trigger")
            Div(class = "row") {
                cn.Tooltip(text = "Removes the row") {
                    cn.Button("Delete", variant = "destructive", size = "small")
                }
                cn.Tooltip(text = "Below, aligned to the start", side = "bottom",
                           align = "start") {
                    cn.Badge("bottom start", variant = "secondary")
                }
                cn.Tooltip(text = "Opens after a beat", open_delay = 800.0) {
                    cn.Label("slow tip")
                }
            }
        }
    }
}
