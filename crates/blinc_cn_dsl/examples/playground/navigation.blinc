// Tabs: panels that swap, driven by a signal either side.

signal section: string = "account"
signal pane: string = "one"

component NavigationWidgets {
    style {
        /* Bare `Text(...)` falls back to black, which is unreadable on a
           dark scheme. Set once here and the panels inherit it; a widget
           that colours its own label keeps it. */
        .group { width: 100%; padding: 24px; gap: 16px; flex-direction: column;
                 color: var(--text-primary) }
        .row { gap: 10px; flex-direction: row; align-items: center; flex_wrap: wrap }
    }

    view {
        Div(class = "group") {
            // Each tab names itself, so its label and its panel are
            // declared together and cannot drift apart.
            cn.Label("tabs: a strip of labelled panels")
            cn.Tabs(value = section) {
                cn.Tab(value = "account", label = "Account", icon = "user") {
                    cn.Card { cn.Label("Name, email, and how we reach you.") }
                }
                cn.Tab(value = "alerts", label = "Alerts", badge = "3") {
                    cn.Card { cn.Label("Three unread notices.") }
                }
                cn.Tab(value = "billing", label = "Billing") {
                    cn.Card { cn.Label("Card ending 4242.") }
                }
                cn.Tab(value = "archive", label = "Archive", disabled = true) {
                    cn.Card { cn.Label("Nothing here yet.") }
                }
            }

            // `value` binds both ways: the buttons move the strip, and
            // clicking the strip writes the signal back.
            cn.Label("the same signal, driven from outside")
            Div(class = "row") {
                cn.Button("Account", size = "small", variant = "outline",
                          on_click = || section.set("account"))
                cn.Button("Alerts", size = "small", variant = "outline",
                          on_click = || section.set("alerts"))
                cn.Button("Billing", size = "small", variant = "outline",
                          on_click = || section.set("billing"))
            }

            // Handles come from the group; only the panels are declared.
            cn.Label("resizable: drag the handle between the panes")
            cn.ResizableGroup(direction = "horizontal", h = 160.0) {
                cn.ResizablePanel(default_size = 180.0, min_size = 120.0, max_size = 320.0) {
                    cn.Card { cn.Label("sidebar pane") }
                }
                cn.ResizablePanel {
                    cn.Card { cn.Label("content takes the rest") }
                }
            }

            cn.Label("small tabs, sliding rather than fading")
            cn.Tabs(value = pane, size = "small", transition = "slide_left") {
                cn.Tab(value = "one", label = "One") {
                    Div { Text("First panel.") }
                }
                cn.Tab(value = "two", label = "Two") {
                    Div { Text("Second panel.") }
                }
            }
        }
    }
}
